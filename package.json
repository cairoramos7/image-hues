{
  "name": "image-hues",
  "version": "1.1.0",
  "description": "Extract dominant colors and contrast colors from images",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.types.json",
    "build:cjs": "esbuild src/index.ts --bundle --platform=browser --target=es2017 --format=cjs --outfile=dist/cjs/index.js && cp config/package.cjs.json dist/cjs/package.json",
    "build:esm": "esbuild src/index.ts --bundle --platform=browser --target=es2017 --format=esm --outfile=dist/esm/index.js && cp config/package.esm.json dist/esm/package.json",
    "build": "npm run clean && npm run build:types && npm run build:cjs && npm run build:esm",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "keywords": [
    "image",
    "color",
    "dominant",
    "contrast",
    "palette"
  ],
  "author": "Cairo Ramos <cairoramos7@gmail.com> (https://github.com/cairoramos7)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairoramos7/image-hues.git"
  },
  "bugs": {
    "url": "https://github.com/cairoramos7/image-hues/issues"
  },
  "homepage": "https://github.com/cairoramos7/image-hues#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.0.0"
  }
}
